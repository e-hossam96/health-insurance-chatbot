{
  "uid": "demo-overview",
  "title": "Demo overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "health-assistant"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sign-ups (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(signups_total[24h]))",
          "legendFormat": "signups"
        }
      ]
    },
    {
      "id": 2,
