POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot

QDRANT_URL=http://localhost:6333
AI_QDRANT_COLLECTION=

SESSION_LIFETIME_DAYS=7

RATE_LIMIT_MESSAGES_PER_MINUTE=6
RATE_LIMIT_MESSAGES_PER_DAY=100
RATE_LIMIT_MESSAGE_MAX_CHARS=1000

KB_STORAGE_DIR=./data/kb
KB_MAX_UPLOAD_BYTES=10485760
INGEST_TIMEOUT_S=600
AI_CHUNK_MAX_TOKENS=512

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_TIMEOUT_S=60
AI_MAX_RETRIES=2

AI_CHAT_BASE_URL=${OPENAI_BASE_URL}
AI_CHAT_API_KEY=${OPENAI_API_KEY}
AI_CHAT_MODEL=gpt-6-luna
AI_CHAT_REASONING_EFFORT=none
AI_CHAT_OUTPUT_TOKEN_PARAM=max_completion_tokens
AI_CHAT_MAX_OUTPUT_TOKENS=800
AI_MAX_TOOL_ROUNDS=4

AI_ROUTER_BASE_URL=${OPENAI_BASE_URL}
AI_ROUTER_API_KEY=${OPENAI_API_KEY}
AI_ROUTER_MODEL=gpt-6-luna
AI_ROUTER_REASONING_EFFORT=none
AI_ROUTER_OUTPUT_TOKEN_PARAM=max_completion_tokens
AI_ROUTER_MAX_OUTPUT_TOKENS=512
AI_ROUTER_HISTORY_ROWS=6

AI_REWRITE_BASE_URL=${OPENAI_BASE_URL}
AI_REWRITE_API_KEY=${OPENAI_API_KEY}
AI_REWRITE_MODEL=gpt-6-luna
AI_REWRITE_REASONING_EFFORT=none
AI_REWRITE_OUTPUT_TOKEN_PARAM=max_completion_tokens
AI_REWRITE_MAX_OUTPUT_TOKENS=1024
AI_QUERY_COUNT=3

AI_JUDGE_BASE_URL=${OPENAI_BASE_URL}
AI_JUDGE_API_KEY=${OPENAI_API_KEY}
AI_JUDGE_MODEL=gpt-6.2-sol
AI_JUDGE_REASONING_EFFORT=low
AI_JUDGE_OUTPUT_TOKEN_PARAM=max_completion_tokens

AI_EMBEDDING_BASE_URL=${OPENAI_BASE_URL}
AI_EMBEDDING_API_KEY=${OPENAI_API_KEY}
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBED_BATCH=64
AI_EMBEDDING_QUERY_PREFIX=
AI_EMBEDDING_DOC_PREFIX=

AI_RETRIEVAL_MODE=hybrid
AI_PREFETCH_K=20
AI_FUSED_K=30
AI_CONTEXT_K=5

AI_RERANK_PROVIDER=none
AI_RERANK_BASE_URL=${OPENAI_BASE_URL}
AI_RERANK_API_KEY=${OPENAI_API_KEY}
