# Required
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# Optional (defaults shown)
QDRANT_URL=http://localhost:6333
SESSION_LIFETIME_DAYS=7
KB_MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_MESSAGES_PER_MINUTE=6
RATE_LIMIT_MESSAGES_PER_DAY=100
RATE_LIMIT_MESSAGE_MAX_CHARS=1000

# Langfuse (tracing disabled if empty)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

KB_STORAGE_DIR=./data/kb

# AI provider config (gate 1). Each role also takes AI_<ROLE>_BASE_URL and AI_<ROLE>_API_KEY;
# keys fall back to OPENAI_API_KEY and base URLs default to OpenAI's.
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-5.5
AI_CHAT_REASONING_EFFORT=none
AI_ROUTER_MODEL=gpt-6-luna
AI_ROUTER_REASONING_EFFORT=none
AI_REWRITE_MODEL=gpt-6-luna
AI_REWRITE_REASONING_EFFORT=none
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_JUDGE_MODEL=gpt-6.1-sol
AI_JUDGE_REASONING_EFFORT=low
AI_RERANK_PROVIDER=none

# Grafana admin password (required by docker compose)
GRAFANA_ADMIN_PASSWORD=

# Production (docker-compose.prod.yml)
DOMAIN=
LETSENCRYPT_EMAIL=
